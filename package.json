{
  "name": "grindline-27",
  "version": "0.2.0",
  "description": "Grindline 27 Android racing league built on LibreCorsa's 500 Hz vehicle simulation.",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "android:sync": "node scripts/android-sync.mjs",
    "android:open": "cap open android",
    "android:run": "cap run android",
    "branding:icons": "node scripts/build-branding.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/run-verify.mjs",
    "verify:laps": "node scripts/run-verify.mjs driver-laps",
    "race:headless": "node --disable-warning=THREE_CJS_DEPRECATED --import tsx scripts/race-headless.ts",
    "physics:report": "node --disable-warning=THREE_CJS_DEPRECATED --import tsx scripts/physics-report.ts",
    "ffb": "tsx scripts/ffb-bridge.ts",
    "compress-tracks": "node scripts/compress-track-glb.mjs --all",
    "upload-hosted": "node scripts/upload-hosted.mjs",
    "car-thumbs": "node --disable-warning=THREE_CJS_DEPRECATED --import tsx scripts/render-car-thumbs.ts",
    "press-kit": "node --import tsx scripts/build-press-kit.ts",
    "home-outlines": "node --import tsx scripts/build-home-outlines.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@takram/three-atmosphere": "^0.19.1",
    "@takram/three-clouds": "^0.7.6",
    "@takram/three-geospatial": "^0.9.1",
    "lucide-react": "^1.65.0",
    "next": "^16.4.1",
    "postprocessing": "^6.39.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@tailwindcss/postcss": "^4.1.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.187.0",
    "meshoptimizer": "^1.3.0",
    "playwright-core": "^1.64.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "wrangler": "^4.157.0"
  },
  "overrides": {
    "postcss": "8.5.30"
  }
}
